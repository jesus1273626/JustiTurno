{
  "name": "justiturno",
  "main": "backend/src/worker.js",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ratelimits": [{"name":"AUTH_LIMITER","namespace_id":"2401","simple":{"limit":10,"period":60}}],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "f9c282572eac42dda0120618b34589ba" }],
  "assets": { "directory": "./frontend/dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/api-docs", "/api-docs/*", "/api-docs.json"] },
  "vars": { "NODE_ENV": "production", "APP_TIMEZONE": "America/Bogota", "MAX_UPLOAD_SIZE_MB": "5" }
}
