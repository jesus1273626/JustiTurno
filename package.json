{
  "name": "justiturno",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "dev:cloudflare": "npm run build:cloudflare && wrangler dev",
    "preview:cloudflare": "npm run dev:cloudflare",
    "deploy:cloudflare": "npm run build:cloudflare && wrangler deploy",
    "dev": "concurrently --kill-others-on-fail \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace frontend",
    "prisma:generate": "npm run prisma:generate --workspace backend",
    "prisma:migrate": "npm run prisma:migrate --workspace backend",
    "prisma:seed": "npm run prisma:seed --workspace backend"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.2",
    "wrangler": "^4.157.0"
  }
}
