generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  EMPLOYEE
  ADMIN
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  RESCHEDULED
  REJECTED
  CANCELED
  ATTENDED
  FINALIZED
}

model User {
  id String @id @default(cuid())
  firstName String
  lastName String
  document String @unique
  phone String
  email String @unique
  passwordHash String
  role Role @default(CITIZEN)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  citizenAppointments Appointment[] @relation("CitizenAppointments")
  assignedAppointments Appointment[] @relation("EmployeeAppointments")
  observations AppointmentObservation[] @relation("ObservationAuthor")
  statusChanges AppointmentStatusHistory[] @relation("StatusChangedBy")
  @@index([role, active])
}

model Service {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  category String
  active Boolean @default(true)
  durationMinutes Int @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requirements Requirement[]
  schedules Schedule[]
  appointments Appointment[]
}

model Requirement {
  id String @id @default(cuid())
  serviceId String
  title String
  description String?
  required Boolean @default(true)
  createdAt DateTime @default(now())
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Schedule {
  id String @id @default(cuid())
  serviceId String
  dayOfWeek Int
  startTime String
  endTime String
  slotDuration Int @default(30)
  capacity Int @default(1)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([serviceId, dayOfWeek, active])
}

model Appointment {
  id String @id @default(cuid())
  code String @unique
  citizenId String
  serviceId String
  assignedEmployeeId String?
  scheduledAt DateTime
  reason String
  status AppointmentStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  citizen User @relation("CitizenAppointments", fields: [citizenId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  assignedEmployee User? @relation("EmployeeAppointments", fields: [assignedEmployeeId], references: [id])
  observations AppointmentObservation[]
  statusHistory AppointmentStatusHistory[]
  @@index([citizenId, scheduledAt])
  @@index([serviceId, scheduledAt])
  @@index([assignedEmployeeId, status])
  @@index([status, scheduledAt])
}

model AppointmentObservation {
  id String @id @default(cuid())
  appointmentId String
  authorId String
  message String
  visibleToCitizen Boolean @default(true)
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author User @relation("ObservationAuthor", fields: [authorId], references: [id])
}

model AppointmentStatusHistory {
  id String @id @default(cuid())
  appointmentId String
  fromStatus AppointmentStatus?
  toStatus AppointmentStatus
  changedById String?
  note String?
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedById], references: [id])
}
