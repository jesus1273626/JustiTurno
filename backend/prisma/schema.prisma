generator client {
  provider = "prisma-client-js"
}

generator worker {
  provider = "prisma-client-js"
  output = "./generated/worker"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  EMPLOYEE
  ADMIN
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  RESCHEDULED
  REJECTED
  CANCELED
  ATTENDED
  FINALIZED
}

enum NotificationType {
  APPOINTMENT_CREATED
  APPOINTMENT_ACCEPTED
  APPOINTMENT_REJECTED
  APPOINTMENT_RESCHEDULED
  APPOINTMENT_CANCELED
  APPOINTMENT_ATTENDED
  APPOINTMENT_FINALIZED
  APPOINTMENT_OBSERVATION
  ACCOUNT_STATUS_CHANGED
}

model User {
  id String @id @default(cuid())
  firstName String
  lastName String
  document String @unique
  phone String
  email String @unique
  passwordHash String
  role Role @default(CITIZEN)
  active Boolean @default(true)
  failedLoginAttempts Int @default(0)
  lockedUntil DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  citizenAppointments Appointment[] @relation("CitizenAppointments")
  assignedAppointments Appointment[] @relation("EmployeeAppointments")
  observations AppointmentObservation[] @relation("ObservationAuthor")
  statusChanges AppointmentStatusHistory[] @relation("StatusChangedBy")
  sessions UserSession[]
  employeeServices EmployeeService[]
  auditLogs AuditLog[]
  notifications Notification[]
  uploadedAttachments AppointmentAttachment[] @relation("AttachmentUploader")
  @@index([role, active])
}

model Service {
  id String @id @default(cuid())
  slug String @unique
  name String
  description String
  category String
  active Boolean @default(true)
  durationMinutes Int @default(30)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  requirements Requirement[]
  schedules Schedule[]
  appointments Appointment[]
  employeeServices EmployeeService[]
}

model Requirement {
  id String @id @default(cuid())
  serviceId String
  title String
  description String?
  required Boolean @default(true)
  createdAt DateTime @default(now())
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model Schedule {
  id String @id @default(cuid())
  serviceId String
  dayOfWeek Int
  startTime String
  endTime String
  slotDuration Int @default(30)
  capacity Int @default(1)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@index([serviceId, dayOfWeek, active])
}

model Appointment {
  id String @id @default(cuid())
  code String @unique
  citizenId String
  serviceId String
  assignedEmployeeId String?
  scheduledAt DateTime
  reason String
  status AppointmentStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  citizen User @relation("CitizenAppointments", fields: [citizenId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])
  assignedEmployee User? @relation("EmployeeAppointments", fields: [assignedEmployeeId], references: [id])
  observations AppointmentObservation[]
  statusHistory AppointmentStatusHistory[]
  attachments AppointmentAttachment[]
  @@index([citizenId, scheduledAt])
  @@index([serviceId, scheduledAt])
  @@index([assignedEmployeeId, status])
  @@index([status, scheduledAt])
}

model Notification {
  id String @id @default(cuid())
  userId String
  type NotificationType
  title String
  message String
  entityType String?
  entityId String?
  readAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
}

model AppointmentAttachment {
  id String @id @default(cuid())
  appointmentId String
  uploadedById String
  originalName String
  storedName String @unique
  mimeType String
  size Int
  path String
  visibleToCitizen Boolean @default(true)
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  content AttachmentContent?
  @@index([appointmentId, createdAt])
}

model AttachmentContent {
  attachmentId String @id
  bytes Bytes
  attachment AppointmentAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
}

model AppointmentObservation {
  id String @id @default(cuid())
  appointmentId String
  authorId String
  message String
  visibleToCitizen Boolean @default(true)
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  author User @relation("ObservationAuthor", fields: [authorId], references: [id])
}

model AppointmentStatusHistory {
  id String @id @default(cuid())
  appointmentId String
  fromStatus AppointmentStatus?
  toStatus AppointmentStatus
  changedById String?
  note String?
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  changedBy User? @relation("StatusChangedBy", fields: [changedById], references: [id])
}

model UserSession {
  id String @id @default(cuid())
  userId String
  jti String @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  revokedAt DateTime?
  lastSeenAt DateTime?
  userAgent String?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model EmployeeService {
  employeeId String
  serviceId String
  createdAt DateTime @default(now())
  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  @@id([employeeId, serviceId])
  @@index([serviceId])
}

model AuditLog {
  id String @id @default(cuid())
  actorId String?
  action String
  entityType String?
  entityId String?
  metadata Json?
  createdAt DateTime @default(now())
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  @@index([action, createdAt])
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
